@model IEnumerable<Cms.Core.DTOs.Shop.ProductDto>
@{
    ViewData["Title"] = "فروشگاه";
}

<main>
    <div class="container">
        <div class="user-account">
            <div class="row">

                <!-- Filters -->
                <div class="col-md-3 col-sm-4 col-xs-12">


                    <section class="user-account-content">
                        <header><h1> فیلتر ها </h1></header>
                        <div class="inner">




                            <aside>
                                <form method="post">
                                    <section>
                                        <header><h3> فیلتر کلیدواژه </h3></header>
                                        <div class="inner">
                                            <div class="form-group">
                                                <input type="text" id="keyword" class="form-control">
                                            </div>
                                        </div>
                                    </section>

                                    <section>
                                        <header><h3> فیلتر قیمت </h3></header>
                                        <div class="inner">

                                            <div class="form-group">
                                                <input type="text" id="minPrice" class="form-control" placeholder="حداکثر">
                                            </div>
                                            <div class="form-group">
                                                <input type="text" id="maxPrice" class="form-control" placeholder="حداقل">
                                            </div>


                                        </div>
                                    </section>

                                    <section>
                                        <header><h3> فیلتر دسته بندی </h3></header>
                                        <div class="inner">
                                            <div class="form-group">
                                                <ul>
                                                    @* @foreach (var item in roles) *@
                                                    {
                                                    <li>
                                                        <div class="checkbox">
                                                            <label>
                                                                <input type="checkbox" name="selectedRoles">
                                                            </label>
                                                        </div>
                                                    </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </section>

                                    <div class="form-group">
                                        <input type="submit" class="btn btn-success" value="اعمال فیلتر" />
                                    </div>
                                </form>

                            </aside>
                        </div>
                    </section>

                </div>




                <!-- Product List -->
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <section class="user-account-content">
                        <header><h1> لیست محصولات </h1></header>
                        <div class="inner">

                            <section class="terms-items">
                                <div class="row">
                                    <!-- col -->
                                    @foreach (var item in Model)
                                    {
                                        <partial name="_ProductBox" model=@item />
                                    }
                                    @* @await Component.InvokeAsync("LastProductsComponent") *@

                                </div>
                            </section>

                        </div>
                    </section>
                </div>

                <!-- Paggination -->
                <div class="row">
                    <div class="col-sm-6">
                    </div>
                    <div class="col-sm-6">
                        <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                            <ul class="pagination">
                                <li class="paginate_button previous " aria-controls="dataTables-example" tabindex="0" id="dataTables-example_previous">
                                    <a href=@($"/Admin/Users?pageid=")>قبلی</a>
                                </li>
                                @* @if (Model.Users.TotalPage > 1) *@
                                @* { *@
                                @* for (int i = 1; i <= Model.Users.TotalPage; i++) *@
                                @* { *@
                                @* var isActive = (i == Model.Users.CurrentPage); *@
                                <li class="paginate_button" aria-controls="dataTables-example" tabindex="0">
                                    <a href="/Admin/Users?pageid=1">1</a>
                                </li>

                                @* } *@
                                @* } *@
                                <li class="paginate_button next" aria-controls="dataTables-example" tabindex="0" id="dataTables-example_next"><a href=@($"/Admin/Users?pageid=")>بعدی</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</main>




