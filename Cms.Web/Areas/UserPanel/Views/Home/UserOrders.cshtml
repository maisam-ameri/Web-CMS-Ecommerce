@using Cms.Core.Convertors
@model IEnumerable<Cms.Core.DTOs.UserPanel.UserOrderDto>
@{
    ViewData["Title"] = "فاکتورهای من";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">خانه</a></li>
            <li class="breadcrumb-item active" aria-current="page">فاکتورها</li>
        </ul>
    </nav>
</div>

<main>
    <div class="container">
        <div class="user-account">
            <div class="row">
                <partial name="~/Areas/UserPanel/Views/Shared/_SideBar.cshtml" />
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <section class="user-account-content">
                        <header><h1>فاکتورهای من </h1></header>
                        <div class="inner">
                            <div class="account-information">
                                @if (Model.Count() > 0)
                                {
                                    <div class="panel-body">
                                        <div class="table-responsive">
                                            <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">

                                                <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                                                    <thead>
                                                        <tr role="row">
                                                            <th style="width: 219px;">تاریخ</th>
                                                            <th style="width: 219px;">تعداد سفارش</th>
                                                            <th style="width: 101px;">وضعیت پرداخت</th>
                                                            <th style="width: 101px;">جزئیات</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @foreach (var item in Model)
                                                        {

                                                            <tr class="gradeA odd">
                                                                <td class="sorting_1">@item.RegisterDate.MiladiToShamsi()</td>
                                                                <td class="sorting_1">@item.DetailOrderCount</td>
                                                                <td class="sorting_1 @(item.IsFinally ? "bg-success" : "bg-danger")">@(item.IsFinally ? "تسویه شده" : "تسویه نشده")</td>
                                                                <td>
                                                                    @if (!item.IsFinally)
                                                                    {
                                                                        <a asp-controller="payment" asp-action="PayOrder" asp-route-orderId="@item.OrderId" class="btn btn-success btn-sm">پرداخت</a>
                                                                        <button class="btn btn-danger btn-sm" onclick="deleteOrder(@item.OrderId)" id="deleteOrderBtn" deleteOrderBtn data-id="@item.OrderId">حذف</button>
                                                                    }
                                                                    <a asp-area="UserPanel" asp-action="UserOrderDetails" asp-route-orderId="@item.OrderId" class="btn btn-warning btn-sm">مشاهده</a>
                                                                </td>

                                                            </tr>

                                                        }

                                                    </tbody>
                                                </table>

                                            </div>
                                        </div>
                                        <!-- /.table-responsive -->

                                    </div>
                                }
                                else
                                {
                                    <p>فاکتوری ثبت نشده است</p>
                                }
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Modal- Delete Order -->
<div class="modal" id="deleteOrderModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel"></h4>
            </div>
            <div class="modal-body" id="modalBody">
            </div>

        </div>
    </div>
</div>
<!-- End Modal -->
<!-- Modal- Payment Error -->
<div class="modal" id="paymentModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title text-danger" id="paymentModalTitle"></h4>
            </div>
            <div class="modal-body" id="paymentModalBody">
            </div>

        </div>
    </div>
</div>
<!-- End Modal -->
@section Scripts{
    @{
        var paymentData = ViewData["paymentData"] as Tuple<int, bool, long>;
        if (paymentData != null)
        {

            if (paymentData.Item2 == false)
            {
                <script>

                    $(document).ready(function () {
                        $('#paymentModal').modal();
                        $('#paymentModalTitle').html('نتیجه پرداخت');
                        $('#paymentModalBody').html('پرداخت فاکتور ' + @paymentData.Item1 + 'با خطا روبرو شد.لطفا مجددا تلاش کنید.');
                    });


                </script>
            }
            else
            {
                <script>

                    $(document).ready(function () {
                        $('#paymentModal').modal();
                        $('#paymentModalTitle').html('نتیجه پرداخت');
                        $('#paymentModalBody').html('پرداخت فاکتور ' + @paymentData.Item1 + 'با موفقیت انجام شد.' + '<br>' + 'کد رهگیری این فاکتور : ' + @paymentData.Item3);
                    });


                </script>
            }
        }

    }

    <script>



        function deleteOrder(orderId) {
            $.get('/UserPanel/DeleteOrder/' + orderId, function (result) {
                $('#deleteOrderModal').modal();
                $('#myModalLabel').html('حذف فاکتور');
                $('#modalBody').html(result);
            });
        }

        function paymentFailed(orderId) {
            console.log(orderId);

            // $.get('/UserPanel/DeleteOrder/' + orderId, function (result) {
            //     $('#deleteOrderModal').modal();
            //     $('#myModalLabel').html('حذف فاکتور');
            //     $('#modalBody').html(result);
        };


    </script>
}
