@using Cms.Core.Convertors
@model IEnumerable<Cms.Core.DTOs.UserPanel.UserOrderDetailDto>
@{
    ViewData["Title"] = "سفارشات من";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">خانه</a></li>
            <li class="breadcrumb-item"><a href="/userpanel/UserOrders">فاکتورها</a></li>
            <li class="breadcrumb-item active" aria-current="page">سفارشات</li>
        </ul>
    </nav>
</div>


<main>
    <div class="container">
        <div class="user-account">
            <div class="row">
                <partial name="_SideBar" />
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <section class="user-account-content">
                        <header><h1>سفارشات من </h1></header>
                        <div class="inner">
                            <div class="account-information">

                                <div class="panel-body">
                                    <div class="table-responsive">
                                        <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">

                                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                                                <thead>
                                                    <tr role="row">
                                                        <th style="width: 219px;">عنوان</th>
                                                        <th style="width: 219px;">تعداد </th>
                                                        <th style="width: 101px;">قیمت</th>
                                                        <th style="width: 101px;">تخفیف</th>
                                                        <th style="width: 219px;">تاریخ</th>
                                                        <th style="width: 101px;">جزئیات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>

                                                    @foreach (var item in Model)
                                                    {

                                                        <tr class="gradeA odd">
                                                            <td class="sorting_1">@item.Title</td>
                                                            <td class="sorting_1">@item.Count</td>
                                                            <td class="sorting_1">@item.Price</td>
                                                            <td class="sorting_1">@(item.DiscountAmount == 0 ? "ندارد" : item.DiscountAmount+ "%")</td>
                                                            <td class="sorting_1">@item.RegisterDate.MiladiToShamsi()</td>
                                                            @if (ViewData["isOrderFinally"] == null)
                                                            {
                                                                <td>
                                                                    <button class="btn btn-danger btn-sm" onclick="deleteOrderDetail(@item.OrderDetailId)" >حذف</button>

                                                                </td>
                                                            }

                                                        </tr>

                                                    }

                                                </tbody>
                                            </table>

                                        </div>
                                    </div>
                                    <!-- /.table-responsive -->


                                    <div class="input-group">
                                        جمع کل : @ViewData["TotalPrice"]  تومان
                                    </div>
                                    @if (ViewData["isOrderFinally"] == null)
                                    {

                                        <div class="input-group">
                                            <a asp-controller="payment" asp-action="PayOrder" asp-route-orderId="@Model.First().OrderId" class="btn btn-success form-control"> پرداخت</a>
                                        </div>

                                    }
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Modal -->
<div class="modal" id="deleteOrderModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel"></h4>
            </div>
            <div class="modal-body" id="modalBody">
            </div>

        </div>
    </div>
</div>

<!-- End Modal -->
@section Scripts{
    <script>
        function deleteOrderDetail(orderDetailId) {
            $.get('/UserPanel/DeleteOrderDetail/' + orderDetailId, function (result) {
                $('#deleteOrderModal').modal();
                $('#myModalLabel').html('حذف سفارش');
                $('#modalBody').html(result);
            });
        }

    </script>
}