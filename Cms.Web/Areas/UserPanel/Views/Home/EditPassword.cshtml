@model Cms.Core.DTOs.EditPasswordDto
@{
    ViewData["Title"] = "تغییر رمز عبور";
}


<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Cms</a></li>
            <li class="breadcrumb-item active" aria-current="page">ویرایش رمز عبور</li>
        </ul>
    </nav>
</div>

<main>
    <div class="container">
        <div class="user-account">
            <div class="row">
                <partial name="_SideBar" />
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <section class="user-account-content">
                        <header><h1> ویرایش رمز عبور </h1></header>

                        @if (ViewBag.isSuccess != null)
                        {
                            <div class="alert alert-success">
                                <p class="help-block"> رمز عبور شما با موفقیت ویرایش شد</p>
                            </div>
                                    <script>
                                        // Your delay in milliseconds
                                        var delay = 3000;
                                setTimeout(function () { window.location = "/Logout?isProfileEdited=true"}, delay);
                                    </script>
                                    
                        }


                        <div class="inner form-layer">
                            <form asp-action="EditPassword" method="post">

                                <div class="row">
                                    
                                    <div class="col-md-7 col-sm-8 col-xs-12">

                                        <div class="input-group">
                                            <span class="input-group-addon" id="password"><i class="zmdi zmdi-key"></i></span>
                                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder=" رمز عبور فعلی" aria-describedby="password">
                                        </div>

                                        <div class="input-group">
                                            <span class="input-group-addon" id="rePassword"><i class="zmdi zmdi-key"></i></span>
                                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="رمز عبور جدید" aria-describedby="password">
                                        </div>

                                        <div class="input-group">
                                            <span class="input-group-addon" id="rePassword"><i class="zmdi zmdi-key"></i></span>
                                            <input asp-for="NewRePassword" type="password" class="form-control" placeholder="تکرار رمز عبور جدید " aria-describedby="password">
                                        </div>
                                    </div>
                                </div>

                                <div class="alert-danger" asp-validation-summary="All"></div>

                                <div class="col-md-7 col-sm-8 col-xs-12">
                                    <button class="btn btn-success"> ویرایش </button>
                                </div>

                            </form>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</main>
