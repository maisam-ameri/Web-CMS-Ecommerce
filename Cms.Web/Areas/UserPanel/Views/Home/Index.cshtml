@using Cms.Core.Convertors
@model Cms.Core.InformationUserDto
@{
    ViewData["Title"] = "پنل کاربری " + Model.UserName;
}

<main>
    <div class="container">
        <div class="user-account">
            <div class="row">
               <partial name="_SideBar"/>
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <section class="user-account-content">
                        <header><h1> داشبورد </h1></header>
                        <div class="inner">
                            <div class="account-information">
                                <h3> اطلاعات کاربری </h3>
                                <ul>
                                    <li> <i class="zmdi zmdi-assignment-account"></i> نام کاربری :  @Model.UserName </li>
                                    <li> <i class="zmdi zmdi-email"></i> ایمیل : @Model.Email </li>
                                    <li> <i class="zmdi zmdi-calendar-check"></i> تاریخ عضویت : @Model.RegisterDate.MiladiToShamsi() </li>
                                    <li> <i class="zmdi zmdi-smartphone-android"></i> موجودی کیف پول : @Model.Wallet </li>
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</main>

