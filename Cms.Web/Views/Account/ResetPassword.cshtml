@model Cms.Core.ResetPasswordDto
@{
    ViewData["Title"] = "تغییر رمز عبور";
}


<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Cms</a></li>
            <li class="breadcrumb-item active" aria-current="page">تغییر رمز عبور</li>
        </ul>
    </nav>
</div>


<main class="client-page">
    <div class="container-content">

        <header><h2> تغییر رمز عبور </h2></header>

        @if (ViewBag.IsSuccessed != null)
        {
            <div class="alert alert-success">
                <p class="help-block"> عزیز ، ایمیل بازیابی کلمه عبور برای شما ارسال گردید.</p>

            </div>
        }


        <div class="form-layer">

            <form action="/ResetPassword" method="post">

                <input hidden type="text" asp-for="ActiveCode" />

                <div class="input-group">
                    <span class="input-group-addon" id="password"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور " aria-describedby="password">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="rePassword"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="RePassword" type="password" class="form-control" placeholder="تکرار رمز عبور " aria-describedby="password">
                </div>


                <div class=" alert-danger" asp-validation-summary="All"></div>


                <button class="btn btn-success"> ثبت </button>

            </form>
        </div>

    </div>
</main>