@model Cms.Core.ForgotPasswordDto
@{
    ViewData["Title"] = "بازیابی کلمه عبور";
}


<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Cms</a></li>
            <li class="breadcrumb-item active" aria-current="page">بازیابی کلمه عبور</li>
        </ul>
    </nav>
</div>


<main class="client-page">
    <div class="container-content">

        <header><h2> بازیابی کلمه عبور </h2></header>

        @if (ViewBag.IsSuccessed != null)
        {
            <div class="alert alert-success">
                <p class="help-block"> عزیز ، ایمیل بازیابی کلمه عبور برای شما ارسال گردید.</p>

            </div>
        }


        <div class="form-layer">

            <form action="/ForgotPassword" method="post">

                <div class="input-group">
                    <span class="input-group-addon" id="email"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="Email" type="text" class="form-control" placeholder="ایمیل" aria-describedby="account">
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>

                <button class="btn btn-success"> ارسال </button>

            </form>
        </div>

    </div>
</main>