@model Cms.Core.RegisterDto

@{
    ViewData["Title"] = "ثبت نام";
}


<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Cms</a></li>
            <li class="breadcrumb-item active" aria-current="page">عضویت در سایت</li>
        </ul>
    </nav>
</div>

<main class="client-page">
    <div class="container-content">

        <header><h2> عضویت در سایت </h2></header>

        <div class="form-layer">

            <form action="/Register" method="post">

                <div class="input-group">
                    <span class="input-group-addon" id="username"><i class="zmdi zmdi-account"></i></span>
                    <input asp-for="UserName" type="text" class="form-control" placeholder="نام کاربری" aria-describedby="username">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="firstName"><i class="zmdi zmdi-account"></i></span>
                    <input asp-for="FirstName" type="text" class="form-control" placeholder="نام" aria-describedby="firstName">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="lastName"><i class="zmdi zmdi-account"></i></span>
                    <input asp-for="LastName" type="text" class="form-control" placeholder="نام خانوادگی" aria-describedby="lastName">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="email-address"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="Email" type="text" class="form-control" placeholder="ایمیل" aria-describedby="email-address">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="password"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="Password" type="text" class="form-control" placeholder="رمز عبور " aria-describedby="password">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="rePassword"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="RePassword" type="text" class="form-control" placeholder="تکرار رمز عبور " aria-describedby="password">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="address"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="Address" type="text" class="form-control" placeholder="آدرس" aria-describedby="email-address">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="phone"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="Phone" type="text" class="form-control" placeholder="شماره تماس" aria-describedby="email-address">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="avatar"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="Avatar" type="text" class="form-control" placeholder="نمایه" aria-describedby="email-address">
                </div>

                <div class="input-group">
                    <span class="input-group-addon" id="avatar"><i class="zmdi zmdi-email"></i></span>
                    <input asp-for="BirthDate" type="date" class="form-control" placeholder="تاریخ تولد" aria-describedby="email-address">
                </div>


                
                <div class="link">
                    <a href="/Login"> <i class="zmdi zmdi-account"></i> ورود به سایت </a>
                </div>

                <button class="btn btn-success"> عضویت در سایت </button>

            </form>
        </div>

    </div>
</main>