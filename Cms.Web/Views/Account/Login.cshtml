@model Cms.Core.LoginDto
@{
    ViewData["Title"] = "ورود به سایت";
}


<div class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Cms</a></li>
            <li class="breadcrumb-item active" aria-current="page">ورود به سایت</li>
        </ul>
    </nav>
</div>


<main class="client-page">
    <div class="container-content">

        <header><h2> ورود به سایت </h2></header>

        @{
            var isProfileEdited = Context.Request.Query["isProfileEdited"].ToString();
            if (isProfileEdited != string.Empty)
            {
                <div class="alert alert-warning">
                    <p class="help-block">به دلیل ویرایش پروفایل ، مجددا وارد شوید</p>

                </div>
            }
        }


        @if (ViewBag.LoginSuccessed != null)
        {
            <div class="alert alert-success">
                <p class="help-block">@Model.UserName عزیز ، خوش آمدید</p>
                <script>
                    // Your delay in milliseconds
                    var delay = 3000;
                    setTimeout(function () { window.location = "/"; }, delay);
                </script>
            </div>
        }


        <div class="form-layer">

            <form action="/Login" method="post">

                <div class="input-group">
                    <span class="input-group-addon" id="username"><i class="zmdi zmdi-account"></i></span>
                    <input asp-for="UserName" type="text" class="form-control" placeholder="نام کاربری" aria-describedby="account">
                </div>
                <span asp-validation-for="UserName" class="text-danger"></span>

                <div class="input-group">
                    <span class="input-group-addon" id="password"><i class="zmdi zmdi-lock"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور " aria-describedby="password">
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="remember-me">
                    <label><input asp-for="RememberMe" type="checkbox">  مرا بخاطر بسپار </label>
                </div>


                <div class="link">
                    <a href="/ForgotPassword"> <i class="zmdi zmdi-lock"></i> رمز عبور خود را فراموش کرده ام !</a>
                    <a href="/Register"> <i class="zmdi zmdi-account"></i> عضویت در سایت </a>
                </div>

                <button class="btn btn-success"> ورود به سایت </button>

            </form>
        </div>

    </div>
</main>