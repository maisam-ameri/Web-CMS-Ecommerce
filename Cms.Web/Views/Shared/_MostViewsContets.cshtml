@using Cms.Core.Convertors
@inject Cms.Core.Services.Abstractions.IContentService _contentService

@{
    var contents = _contentService.GetMostViewsContents();
}



<!-- most views news -->
<section class="panel panel-danger">
    <div class="panel-heading">
        <h3 class="panel-title">
            پربازدید ها
        </h3>
    </div>
    <ul>
        @foreach (var item in contents)
        {
            <li>
                <img class="border-radius thumbnail" width="100px" height="100px" src="/images/content/thumbnail/@item.ImageName">
                <h2> <a href="/News/1">@item.Title</a></h2>
                <span>انتشار : @item.PublishDate.MiladiToShamsi()</span>
            </li>
        }
    </ul>
</section>
<!-- end most views news -->