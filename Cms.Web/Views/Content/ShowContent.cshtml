@using Cms.Core.Convertors
@model Cms.DataLayer.Entities.Content.BaseContent
@{
    ViewData["Title"] = Model.Title;
    var comments = ViewData["comments"] as List<Cms.DataLayer.Entities.Content.ContentComment>;
}

<style>
    .single-news img {
        max-width: 100%;
    }

    #contentBox {
        background-color: #dae1e3;
    }
</style>

<div class="container">
    <div class="row">



        <aside class="col-md-4 col-sm-12 col-xs-12 pull-right">


            <!-- most views news -->
            <partial name="_MostViewsContets" />
            <!-- end most views news -->
            <!-- Lates news -->
            <partial name="_LatesContents" />
            <!-- Lates  news -->

        </aside>


        <div class="col-md-8 col-sm-12 col-xs-12 pull-right " id="contentBox">
            <section class=" border-radius">
                <header>
                    <h2> @Model.Title </h2>
                    <span> <i class="fa fa-calendar"></i>  انتشار : @Model.ModifiedDate.MiladiToShamsi()</span>
                </header>
                <article>
                    <p>
                        @Model.ShortDescription
                    </p>
                    <di>
                        <img src="/images/content/@Model.ImageName" class="thumbnail" style="max-width: auto; margin: 10px auto" />
                    </di>
                    <p>
                        @Html.Raw(Model.MainText)
                    </p>
                </article>
            </section>

            <div class="keywords border-radius">
                <span> کلید واژه ها: </span>
                @foreach (var item in Model.Tags.Split(','))
                {

                    <a href="/Content/SearchContent?keyword=@item" type="button" class="btn btn-default">
                        @item
                    </a>

                }

            </div>

            <hr />
            <section class="comment-layer">

                <div class="form-group">
                    <header> <i class="fa fa-comments"></i><h5> دیدگاه کاربران (@(comments == null ? "0" : comments.Count)) </h5> </header>
                </div>
                <div class="form-group">

                    <ul id="commentList">
                    </ul>
                </div>


                <br />
                <form role="form">
                    <div class="form-group">
                        <label>نام و نام خانوادگی</label>
                        <input class="form-control" id="txtName">
                        <p class="help-block"></p>
                    </div>
                    <div class="form-group">
                        <label>ایمیل</label>
                        <input class="form-control" id="txtEmail">
                    </div>


                    <div class="form-group">
                        <label>دیدگاه</label>
                        <textarea class="form-control" rows="3" id="txtComment"></textarea>
                    </div>





                    <div class="form-group">
                        <input type="button" class="btn btn-success" onclick="addComment()" value="ثبت دیدگاه">
                    </div>
                </form>
            </section>












        </div>
    </div>
</div>

@section Scripts{
    <script>

        $(document).ready(function () {
            getComments(@Model.ContentId);
        });

        function getComments(contentId) {

            console.log(contentId);
            $.ajax({
                url: "/Content/GetComments/" + @Model.ContentId,
                type: "Get",

            }).done(function (result) {
                $("#commentList").html(result);
            });
        }

        function addComment() {

            var name = $("#txtName").val();
            var email = $("#txtEmail").val();
            var comment = $("#txtComment").val();

            $.ajax({
                url: "/Content/AddComment/" + @Model.ContentId,
                type: "Post",

                data: {
                    name: name,
                    email: email,
                    comment: comment
                },

                contentType: "application/x-www-form-urlencoded"

            }).done(function (result) {
                $("#commentList").html(result);

                $("#txtName").val("");
                $("#txtEmail").val("");
                $("#txtComment").val("");

            });
        }
    </script>
}