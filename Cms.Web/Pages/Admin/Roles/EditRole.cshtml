@page "{id}"
@model Cms.Web.Pages.Admin.Roles.EditRoleModel
@{

    ViewData["Title"] = "ویرایش نقش";
}


<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">ویرایش نقش</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>

<div class="row">
<p>@Model.Role.RoleTitle</p>
    <form method="post">
        <input type="hidden" asp-for="Role.RoleId" />
        <div class="col-md-8">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    ویرایش نقش
                </div>
                <!-- /.panel-heading -->
                <div class="panel-body">

                    <div class="form-group">
                        <label>عنوان نقش</label>
                        <input type="text" asp-for="Role.RoleTitle" class="form-control" >
                    </div>

                    <input type="submit" class="btn btn-success" value="ویرایش" />

                </div>
                <!-- /.panel-body -->
            </div>
        </div>
       
    </form>
</div>