@page
@model Cms.Web.Pages.Admin.Product.IndexModel
@{
    var categories = ViewData["categories"] as List<Cms.DataLayer.Entities.Product.Category>;
    ViewData["Title"] = "لیست گروه ها";
}


<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">لیست گروه محصولات</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<!-- /.row -->
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                لیست گروه ها
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="table-responsive">
                    <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                        <div class="col-md-12" style="margin:12px 0px">
                            <div class="row">
                                <a href="/Admin/Category/CreateCategory" class="btn btn-outline btn-success">افزودن گروه</a>
                            </div>
                        </div>

                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                            <thead>
                                <tr role="row">
                                    <th style="width: 219px;">عنوان گروه</th>
                                    <th style="width: 101px;">دستورات</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in categories)
                                {

                                    <tr class="gradeA odd">
                                        <td class="sorting_1">@item.Title</td>
                                        <td>
                                            <a asp-page="EditCategory" asp-route-id="@item.Id" class="btn btn-warning btn-sm">ویرایش</a>
                                            <a asp-page="DeleteCategory" asp-route-id="@item.Id" class="btn btn-danger btn-sm">حذف</a>
                                        </td>

                                    </tr>

                                }

                            </tbody>
                        </table>

                    </div>
                </div>
                <!-- /.table-responsive -->

            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->
    </div>
    <!-- /.col-lg-12 -->
</div>