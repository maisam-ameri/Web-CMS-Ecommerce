@page
@model Cms.Web.Pages.Admin.Category.CreateCategoryModel
@{
    ViewData["Title"] = "ایجاد گروه جدید";
    var data = ViewData["Categories"] as IEnumerable<Cms.Core.DTOs.AdminPanel.Product.CategoryDto>;
    var categories = new SelectList(data, "Id", "Title");// as SelectList;//as SelectList<Cms.Core.DTOs.AdminPanel.Product.CategoryDto>;

}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">افزودن گروه جدید</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>

<div class="row">
    <form method="post">

        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    مشخصات گروه
                </div>
                <!-- /.panel-heading -->
                <div class="panel-body">

                    <div class="form-group">
                        <label>عنوان گروه</label>
                        <input type="text" asp-for="Category.Title" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>گروه والد</label>

                        <select class="form-control" name="parentCategoryId"  asp-items=@categories>
                            <option value="">گروه اصلی</option>
                        </select>

                    </div>

                    <input asp-page="/Admin/Category/CreateCategory" type="submit" class="btn btn-success" value="افزودن" />
                </div>
                
                <!-- /.panel-body -->
            </div>
        </div>

    </form>
</div>


