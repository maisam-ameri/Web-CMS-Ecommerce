@page
@model Cms.Web.Pages.Admin.Content.Category.DeleteContentCategoryModel
@{
    ViewData["Title"] = "حذف گروه";
}


<div class="container alert alert-danger">
    <p>آیا از حذف " @Model.Category.Title " مطمئن هستید ؟</p>
    <form method="post">
        <input type="hidden" asp-for="Category.CategoryId" />
        <input type="hidden" asp-for="Category.Title" />
        <input type="submit" value="بلی" class="btn btn-danger" />
    </form>
</div>