@page
@model Cms.Web.Pages.Admin.Content.Category.EditContentCategoryModel
@{
    ViewData["Title"] = "ویرایش گروه";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">ویرایش گروه</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>

<div class="row">
    <form method="post">
        <input type="hidden" asp-for="Category.CategoryId" />
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    مشخصات گروه
                </div>
                <!-- /.panel-heading -->
                <div class="panel-body">

                    <div class="form-group">
                        <label>عنوان گروه</label>
                        <input type="text" asp-for="Category.Title" class="form-control" value="@Model.Category.Title">
                    </div>

                    <input type="submit" class="btn btn-warning" value="ویرایش" />

                    @* <input asp-page="/Admin/Category/EditCategory" type="submit" class="btn btn-warning" value="ویرایش" /> *@
                </div>

                <!-- /.panel-body -->
            </div>
        </div>

    </form>
</div>
