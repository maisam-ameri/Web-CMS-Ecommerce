@page
@model Cms.Web.Pages.Admin.Content.BaseContent.IndexModel
@{
    ViewData["Title"] = "لیست محتوا";
    var contents = ViewData["Contents"] as List<Cms.DataLayer.Entities.Content.BaseContent>;
}


<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">لیست محتوا ها</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<!-- /.row -->
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                لیست محتوا
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="table-responsive">
                    <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                        <div class="col-md-12" style="margin:12px 0px">
                            <div class="row">
                                <a asp-page="CreateBaseContent" class="btn btn-outline btn-success">افزودن محتوا</a>
                            </div>
                        </div>

                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                            <thead>
                                <tr role="row">
                                    <th style="width: 219px;"></th>
                                    <th style="width: 219px;">عنوان محتوا</th>
                                    <th style="width: 219px;">توضیح مختصر </th>
                                    <th style="width: 219px;">تاریخ انتشار </th>
                                    <th style="width: 219px;">وضعیت </th>
                                    <th style="width: 101px;">دستورات</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in contents)
                                {

                                    <tr class="gradeA odd">
                                        <td class="sorting_1">
                                            <img class="thumbnail" width="150" height="150" src="/images/content/@item.ImageName">
                                        </td>
                                        <td class="sorting_1">@item.Title</td>
                                        <td class="sorting_1">@item.ShortDescription</td>
                                        <td class="sorting_1">@item.PublishDate.MiladiToShamsi()</td>
                                        <td class="sorting_1">@(item.IsPublished ? "منتشر شده" : "در صف انتشار")</td>
                                        <td>
                                            <a asp-page="EditBaseContent" asp-route-id="@item.ContentId" class="btn btn-warning btn-sm">ویرایش</a>
                                            <a asp-page="DeleteBaseContent" asp-route-id="@item.ContentId" class="btn btn-danger btn-sm">حذف</a>
                                        </td>

                                    </tr>

                                }

                            </tbody>
                        </table>

                    </div>
                </div>
                <!-- /.table-responsive -->

            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->
    </div>
    <!-- /.col-lg-12 -->
</div>

