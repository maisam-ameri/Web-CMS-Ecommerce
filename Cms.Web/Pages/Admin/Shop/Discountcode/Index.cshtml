@page
@using Cms.Core.Convertors
@model Cms.Web.Pages.Admin.Shop.Discountcode.IndexModel
@{
    ViewData["Title"] = "لیست کدهای تخفیف ";
    var discountCodes = ViewData["discountCodes"] as List<Cms.DataLayer.Entities.Shop.DiscountCode>;
}


<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">لیست کدهای تخفیف</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>

<!-- /.row -->
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                لیست کدهای تخفیف
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="table-responsive">
                    <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                        <div class="col-md-12" style="margin:12px 0px">
                            <div class="row">
                                <a asp-page="CreateDiscountCode" class="btn btn-outline btn-success">افزودن کد تخفیف</a>
                            </div>
                        </div>
                        @if (discountCodes != null && discountCodes?.Count != 0)
                        {

                            <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                                <thead>
                                    <tr role="row">
                                        <th style="width: 280px;">عنوان </th>
                                        <th style="width: 60px;">تخفیف</th>
                                        <th style="width: 200px;">تاریخ شروع</th>
                                        <th style="width: 200px;">تاریخ پایان</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in discountCodes)
                                    {

                                        <tr class="gradeA odd">
                                            <td class="sorting_1">@item.Title</td>
                                            <td class="sorting_1">@(item.Amount)% </td>
                                            <td class="sorting_1">@item.StartDate.MiladiToShamsi() </td>
                                            <td class="sorting_1">@item.EndDate.MiladiToShamsi()</td>
                                            <td>
                                                <a asp-page="EditDiscount" asp-route-id="@item.DiscountCodeId" class="btn btn-warning btn-sm">ویرایش</a>
                                                <a asp-page="DeleteDiscount" asp-route-id="@item.DiscountCodeId" class="btn btn-danger btn-sm">حذف</a>
                                            </td>

                                        </tr>

                                    }

                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="help-block text-warning">کد تخفیفی موجود نیست</div>
                        }

                    </div>
                </div>
                <!-- /.table-responsive -->

            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->
    </div>
    <!-- /.col-lg-12 -->
</div>
