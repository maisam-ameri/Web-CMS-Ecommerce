@page
@model Cms.Web.Pages.Admin.Shop.Discountcode.AssignDiscountCodeToUserModel
@{
    var roles = ViewData["roles"] as SelectList;
    ViewData["Title"] = "کاربران";
    var selectedRoles = ViewData["selectedRoles"] as List<string>;
    var discountCodeId = ViewData["discountCodeId"]?.ToString();
}


<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">لیست کاربران</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>


<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                افزودن کاربر بر اساس نقش
            </div>

            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="row">
                    <form method="post">
                        <input type="hidden" name="discountCodeId" value="@discountCodeId" />
                        <div class="col-sm-5 col-md-5">

                            <ul>

                                @foreach (var item in roles)
                                {
                                    <li>
                                        <div class=" checkbox">
                                            <label>

                                                @if (selectedRoles != null)
                                                {

                                                    @if (selectedRoles.Any(r => r == item.Value))
                                                    {
                                                        <input type="checkbox" checked="checked" name="selectedRoles" value="@item.Value">
                                                        @item.Text
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" name="selectedRoles" value="@item.Value">
                                                        @item.Text
                                                    }

                                                }
                                                else
                                                {
                                                    <input type="checkbox" name="selectedRoles" value="@item.Value">
                                                    @item.Text

                                                }
                                            </label>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="col-sm-2 col-md-2">
                            <button type="submit" class="btn btn-success">افزودن</button>
                        </div>
                    </form>
                </div>

            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->
    </div>
</div>

