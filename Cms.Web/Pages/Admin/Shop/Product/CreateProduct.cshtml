@page
@model Cms.Web.Pages.Admin.Shop.Product.CreateProductModel
@{
    ViewData["Title"] = "افزودن محصول جدید";
    var categories = ViewData["categories"] as SelectList;

}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">افزودن محصول جدید</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>

<div class="row">
    @Html.AntiForgeryToken()
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Product.ImageName" />
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    اطلاعات محصول
                </div>
                <!-- /.panel-heading -->
                <div class="panel-body">

                    <div class="form-group">
                        <label>نام محصول</label>
                        <input type="text" asp-for="Product.Title" class="form-control">
                    </div>

                    <div class="form-group">
                        <label>گروه</label>

                        <select class="form-control" id="categories" asp-items=@categories>
                        </select>


                    </div>

                    <div class="form-group">
                        <label>زیر گروه</label>

                        <select class="form-control" id="subCategories"  name="categoryId">
                        </select>

                    </div>

                    <div class="form-group">
                        <label>توضیحات</label>
                        <textarea asp-for="Product.Description" class="form-control"></textarea>
                    </div>

                    <div class="form-group">
                        <label>محتوا</label>
                        <textarea asp-for="Product.Content" class="form-control"></textarea>
                    </div>

                    <div class="form-group">
                        <label>تگ ها</label>
                        <textarea asp-for="Product.Tags" class="form-control"></textarea>
                        <div class="help-block">لطفا بین تگ ها از '،' استفاده کنید</div>
                    </div>

                    <div class="form-group">
                        <label>قیمت(تومان)</label>
                        <input type="number" asp-for="Product.Price" class="form-control"/>
                    </div>

                    <input asp-page="CreateProduct" type="submit" class="btn btn-success" value="افزودن" />

                </div>

                <!-- /.panel-body -->
            </div>
        </div>

        <div class="col-md-4">

            <div class="panel panel-default">
                <div class="panel-heading">
                    تصویر محصول
                </div>
                <!-- /.panel-heading -->
                <div class="panel-body">
                    <img id="imgProduct" class="thumbnail" src="/images/pic/avatar.jpg" />
                    <div class="form-group">
                        <label>انتخاب تصویر</label>
                        <input type="file" asp-for="Product.Image" value="default.jpg">
                    </div>
                </div>
                <!-- /.panel-body -->
            </div>


        </div>
    </form>
</div>

@section Scripts{
    <script>

        $(document).ready(function () {
            $('#categories').prepend('<option value= 0 > انتخاب گروه</option>');
            $('#categories').val(0);
            $('#subCategories').prop('disabled', true);

        });

        $('#categories').change(function () {

            $('#subCategories').empty();
            $('#subCategories').prop('disabled', true);
            var categoryId = $('#categories').val();
            console.log(categoryId);
            var url = "CreateProduct?handler=SubCategories&categoryId=" + categoryId;
            
            $.getJSON(
                url,

                function (response) {
                    var len = Object.keys(response).length;
                    console.log(len);
                    if (len > 0) {

                        $.each(response, function () {
                            $('#subCategories').prop('disabled', false);
                            $('#subCategories').append('<option value=' + this.value + '>' + this.text + '</option>');
                        });
                       
                    }
                    else {
                        $('#subCategories').append('<option> زیر گروه موجود نیست</option>');
                    }


                });
        });

        
        function readURL(input) {

            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imgProduct').attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#Product_Image").change(function () {
            readURL(this);
        });

    </script>

    <script src="https://cdn.ckeditor.com/4.9.2/standard/ckeditor.js"></script>
    <script>

        CKEDITOR.replace('Product_Content',
            {
                customConfig: '/js/ckEditorConfig.js'
            }

        );

    </script>
}
