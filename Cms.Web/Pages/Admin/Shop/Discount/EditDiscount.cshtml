@page
@model Cms.Web.Pages.Admin.Shop.Discount.EditDiscountModel
@{
    ViewData["Title"] = "ویرایش تخفیف";
    var products = ViewData["products"] as SelectList;
    var discountProductIds = ViewData["discountProductIds"] as List<int>;

}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">افزودن تخفیف جدید</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>


<div class="row">
    @Html.AntiForgeryToken()
    <form method="post">
        <input type="hidden" asp-for="Discount.DiscountId" />
        <input type="hidden" asp-for="Discount.JobId" />
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    اطلاعات تخفیف
                </div>
                <!-- /.panel-heading -->
                <div class="panel-body">

                    <div class="form-group">
                        <label>عنوان تخفیف</label>
                        <input type="text" asp-for="Discount.Title" class="form-control">
                    </div>

                    <div class="form-group">
                        <label>محصولات</label>
                        @if (products != null)
                        {
                            <select id="productSelection" class="form-control" multiple aria-label="multiple select example" asp-items=@products name="selectedProducts">
                            </select>
                        }
                    </div>

                    <div class="form-group">
                        <label>درصد تخفیف</label>
                        <input type="number" asp-for="Discount.Amount" class="form-control">
                    </div>

                    <div class="form-group">
                        <label>تاریخ شروع</label>
                        <input type="date" asp-for="Discount.StartDate" class="form-control">
                    </div>

                    <div class="form-group">
                        <label>تاریخ پایان</label>
                        <input type="date" asp-for="Discount.EndDate" class="form-control">
                    </div>

                    <input asp-page="EditDiscount" type="submit" class="btn btn-success" value="ویرایش" />

                </div>

                <!-- /.panel-body -->
            </div>
        </div>
    </form>
</div>


@section Scripts{

    <script>

        $(document).ready(function () {
            highlightSelection();
        });

        function highlightSelection() {

            const productSelection = document.getElementById('productSelection');
            const options = productSelection.options;
            var productSelected = JSON.parse('@Json.Serialize(discountProductIds)');
         
            for (let i = 0; i < options.length; i++) {
                for (let k = 0; k < productSelected.length; k++) {
                    if (productSelected[k] == options[i].value) {
                        options[i].selected = 'true';
                    }
                }
            }
        }

    </script>
}
