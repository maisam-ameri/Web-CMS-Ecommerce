@page
@model Cms.Web.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "کاربران";
}

<div class="row">
    <div class="col-lg-12">
        <h1 class="page-header">لیست کاربران سایت</h1>
    </div>
    <!-- /.col-lg-12 -->
</div>
<!-- /.row -->
<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                DataTables Advanced Tables
            </div>
            <!-- /.panel-heading -->
            <div class="panel-body">
                <div class="table-responsive">
                    <div id="dataTables-example_wrapper" class="dataTables_wrapper form-inline" role="grid">
                        <div class="row">
                            <form method="get">
                                <div class="col-sm-5 col-md-5">

                                    <input type="text" name="usernameFilter" class="form-control " placeholder="نام کاربری">
                                </div>
                                <div class="col-sm-5 col-md-5">
                                    <input type="text" name="emailFilter" class="form-control " placeholder="ایمیل">

                                </div>
                                <div class="col-sm-2 col-md-2">
                                    <button type="submit" class="btn btn-info">جستجو</button>
                                </div>
                            </form>
                        </div>
                        <div class="col-md-12" style="margin:12px 0px">
                            <div class="row">
                                <a href="/Admin/users/CreateUser" class="btn btn-outline btn-success">افزودن کاربر جدید</a>
                            </div>
                        </div>

                        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
                            <thead>
                                <tr role="row">
                                    <th style="width: 219px;">نام کاربری</th>
                                    <th style="width: 200px;">ایمیل</th>
                                    <th style="width: 143px;">وضعیت</th>
                                    <th style="width: 101px;">تاریخ ثبت نام</th>
                                    <th style="width: 101px;">دستورات</th>
                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var item in Model.Users.Users)
                                {

                                    <tr class="gradeA odd">
                                        <td class="sorting_1">@item.UserName</td>
                                        <td class=" ">@item.Email</td>
                                        <td class="center ">
                                            @if (item.IsActive)
                                            {
                                                <p class="text-success">فعال</p>
                                            }
                                            else
                                            {
                                                <p class="text-danger">غیر فعال</p>
                                            }

                                        </td>
                                        <td>@item.RegisteredDate.MiladiToShamsi()</td>
                                        <td>
                                            <a href="/" class="btn btn-warning btn-sm">ویرایش</a>
                                            <a href="/" class="btn btn-danger btn-sm">حذف</a>
                                        </td>
                                    </tr>

                                }

                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="dataTables_info" id="dataTables-example_info" role="alert" aria-live="polite" aria-relevant="all">Showing 1 to 10 of 57 entries</div>
                            </div>
                            <div class="col-sm-6">
                                <div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate">
                                    <ul class="pagination">
                                        <li class="paginate_button previous @(Model.Users.CurrentPage <=1 ? "hidden" :"") " aria-controls="dataTables-example" tabindex="0" id="dataTables-example_previous">
                                            <a href=@($"/Admin/Users?pageid={Model.Users.CurrentPage-1}")>قبلی</a>
                                        </li>
                                        @if (Model.Users.TotalPage > 1)
                                        {
                                            for (int i = 1; i <= Model.Users.TotalPage; i++)
                                            {
                                                var isActive = (i == Model.Users.CurrentPage);
                                                <li class="paginate_button @(isActive ? "active": "") aria-controls="dataTables-example" tabindex="0">
                                                    <a href="/Admin/Users?pageid=@i">@i</a>
                                                </li>

                                            }
                                        }
                                        <li class="paginate_button next @(Model.Users.CurrentPage >= Model.Users.TotalPage ? "hidden" :"")" aria-controls="dataTables-example" tabindex="0" id="dataTables-example_next"><a href=@($"/Admin/Users?pageid={Model.Users.CurrentPage+1}")>بعدی</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- /.table-responsive -->

            </div>
            <!-- /.panel-body -->
        </div>
        <!-- /.panel -->
    </div>
    <!-- /.col-lg-12 -->
</div>


